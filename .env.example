# Local-MCP-Bridge example environment file
# Copy to .env for local use. Never commit the real .env file.

# MCP server bind settings
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Optional authentication/tunnel values belong only in the local .env.
# Never put real credentials in this example file.
# MCP_AUTH_TOKEN=replace-locally
# CLOUDFLARE_TUNNEL_TOKEN=replace-locally

# Local configuration path
MCP_CONFIG_PATH=config/config.yaml

# Runtime directories (ignored by Git)
MCP_RUNTIME_DIR=runtime
MCP_LOG_DIR=logs
MCP_JOB_DIR=jobs
