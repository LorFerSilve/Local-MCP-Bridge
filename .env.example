# Local-MCP-Bridge example environment file
# Copy to .env for local use if you choose to manage environment values that way.
# The bridge does not automatically load .env files; export variables in the host process
# or use a launcher that loads them. Never commit the real .env file.

# Reserved MCP server bind settings for later HTTP/tunnel phases.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Remote authentication is explicit. Phase 9 pre-shared bearer remains the default.
LOCAL_MCP_BRIDGE_REMOTE_AUTH_MODE=pre_shared_bearer
# LOCAL_MCP_BRIDGE_REMOTE_TOKEN=replace-with-a-high-entropy-local-secret

# Phase 10.5 OAuth mode for a preconfigured Claude confidential client:
# LOCAL_MCP_BRIDGE_REMOTE_AUTH_MODE=oauth
# LOCAL_MCP_BRIDGE_OAUTH_CLIENT_ID=replace-with-a-local-client-id
# LOCAL_MCP_BRIDGE_OAUTH_CLIENT_SECRET=replace-with-a-high-entropy-local-client-secret

# Tunnel-provider credentials remain outside bridge configuration.
# CLOUDFLARE_TUNNEL_TOKEN=replace-locally

# Active Phase 2 local configuration override.
# If unset, the bridge looks for config/config.yaml and otherwise starts with an empty registry.
LOCAL_MCP_BRIDGE_CONFIG=config/config.yaml

# Reserved runtime directories for later phases (ignored by Git).
MCP_RUNTIME_DIR=runtime
MCP_LOG_DIR=logs
MCP_JOB_DIR=jobs
